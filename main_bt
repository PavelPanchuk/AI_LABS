import numpy as np
import matplotlib.pyplot as plt

# Функция активации Swish (работает лучше, чем ReLU)
def swish(x):
    return x / (1 + np.exp(-x))

def swish_derivative(x):
    sig = 1 / (1 + np.exp(-x))
    return sig + x * sig * (1 - sig)

def tanh_derivative(x):
    return 1 - np.tanh(x) ** 2

# Генерация данных (расширенный диапазон X)
np.random.seed(42)
X = np.linspace(-1.5, 1.5, 150).reshape(-1, 1)  # Расширенный диапазон
Y = 2*X**3 - 3*X**2 + 0.5*X + 1
Y += np.random.normal(0, 0.1, size=Y.shape)  # Добавляем шум

# Добавим новые признаки (X^2, X^3)
X_poly = np.hstack([X, X**2, X**3])

# Мин-Макс нормализация входов
X_min, X_max = X_poly.min(), X_poly.max()
X_poly = (X_poly - X_min) / (X_max - X_min) * 2 - 1  # Нормализация [-1, 1]

# Параметры нейросети
input_size = X_poly.shape[1]  # Теперь у нас 3 входных признака
hidden_size1 = 64  
hidden_size2 = 50  
hidden_size3 = 32  
output_size = 1
learning_rate = 0.005
epochs = 30000  
batch_size = 15
l2_lambda = 0.0001  

# Инициализация весов (Xavier)
W1 = np.random.randn(input_size, hidden_size1) * np.sqrt(2 / input_size)
W2 = np.random.randn(hidden_size1, hidden_size2) * np.sqrt(2 / hidden_size1)
W3 = np.random.randn(hidden_size2, hidden_size3) * np.sqrt(2 / hidden_size2)
W4 = np.random.randn(hidden_size3, output_size) * np.sqrt(2 / hidden_size3)

# Dropout коэффициенты
dropout_rate = 0.1  

# Обучение сети
for epoch in range(epochs):
    indices = np.random.choice(X_poly.shape[0], batch_size, replace=False)
    X_batch = X_poly[indices]
    Y_batch = Y[indices]

    # Прямое распространение
    hidden_input1 = np.dot(X_batch, W1)
    hidden_output1 = swish(hidden_input1)
    hidden_output1 *= np.random.binomial(1, 1 - dropout_rate, hidden_output1.shape)  # Dropout

    hidden_input2 = np.dot(hidden_output1, W2)
    hidden_output2 = swish(hidden_input2)
    hidden_output2 *= np.random.binomial(1, 1 - dropout_rate, hidden_output2.shape)  # Dropout

    hidden_input3 = np.dot(hidden_output2, W3)
    hidden_output3 = np.tanh(hidden_input3)

    final_input = np.dot(hidden_output3, W4)
    final_output = final_input  # Линейный выход

    # Вычисление ошибки
    error = Y_batch - final_output
    loss = np.mean(error ** 2) + l2_lambda * (np.sum(W1**2) + np.sum(W2**2) + np.sum(W3**2) + np.sum(W4**2))

    # Обратное распространение
    d_output = error  
    d_hidden3 = d_output.dot(W4.T) * tanh_derivative(hidden_input3)
    d_hidden2 = d_hidden3.dot(W3.T) * swish_derivative(hidden_input2)
    d_hidden1 = d_hidden2.dot(W2.T) * swish_derivative(hidden_input1)

    # Градиентный спуск с L2-регуляризацией
    W4 += learning_rate * hidden_output3.T.dot(d_output) / batch_size - l2_lambda * W4
    W3 += learning_rate * hidden_output2.T.dot(d_hidden3) / batch_size - l2_lambda * W3
    W2 += learning_rate * hidden_output1.T.dot(d_hidden2) / batch_size - l2_lambda * W2
    W1 += learning_rate * X_batch.T.dot(d_hidden1) / batch_size - l2_lambda * W1

    # Вывод ошибки каждые 5000 эпох
    if epoch % 5000 == 0:
        print(f"Эпоха {epoch}, Ошибка: {loss:.6f}")

# Предсказание
X_test = np.linspace(-2, 2, 200).reshape(-1, 1)  # Проверим экстраполяцию
X_test_poly = np.hstack([X_test, X_test**2, X_test**3])
X_test_poly = (X_test_poly - X_min) / (X_max - X_min) * 2 - 1  # Мин-Макс нормализация

hidden_test1 = swish(np.dot(X_test_poly, W1))
hidden_test2 = swish(np.dot(hidden_test1, W2))
hidden_test3 = np.tanh(np.dot(hidden_test2, W3))
Y_pred = np.dot(hidden_test3, W4)

# График
plt.scatter(X, Y, label="Исходные данные", alpha=0.6)
plt.plot(X_test, Y_pred, color="red", label="Предсказания НС", linewidth=2)
plt.legend()
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Интерполяция полиномом нейросетью с улучшенной экстраполяцией")
plt.show()
